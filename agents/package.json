{
  "name": "qma-cli",
  "version": "2.2.1",
  "license": "MIT",
  "description": "Bounded autonomous buyer-agent CLI and SDK for QMA x402 intelligence reports.",
  "keywords": [
    "agent",
    "circle",
    "cli",
    "usdc",
    "x402"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoanlv214/qma.git",
    "directory": "agents"
  },
  "homepage": "https://github.com/hoanlv214/qma/tree/main/agents#readme",
  "bugs": {
    "url": "https://github.com/hoanlv214/qma/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "qma": "bin/qma.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./circle-wallet": {
      "types": "./dist/wallets/circleSigner.d.ts",
      "import": "./dist/wallets/circleSigner.js"
    }
  },
  "type": "module",
  "files": [
    "dist",
    "bin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node scripts/cli_smoke.mjs && node scripts/fast_parser_smoke.mjs && node scripts/qma_agent_planner_smoke.mjs && node scripts/session_smoke.mjs && node scripts/worker_concurrency_smoke.mjs && node scripts/payment_executor_smoke.mjs && node scripts/qma_agent_payment_smoke.mjs && node scripts/durable_tick_smoke.mjs",
    "clean": "node scripts/clean.mjs",
    "prepack": "npm run clean && npm test",
    "start:worker": "npm run build && node dist/worker.js"
  },
  "dependencies": {
    "viem": "^2.48.11"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.6.3"
  }
}
