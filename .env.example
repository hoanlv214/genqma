# QMA minimal environment
# Copy to .env, then fill only the values that are specific to your deployment.

# Wallet roles
# Platform treasury: receives the buyer's one x402 payment, then funds verdict settlement.
QMA_PLATFORM_TREASURY_ADDRESS=0xplatform_treasury_wallet
# Backward-compatible alias used by older docs/deploys.
QMA_ARC_SELLER_ADDRESS=0xplatform_treasury_wallet

# Provider owner wallets: used for creator/provider accounting and claimable revenue.
QMA_FUNDING_MEMORY_OWNER_WALLET=0xfunding_provider_owner_wallet
QMA_OI_MEMORY_OWNER_WALLET=0xoi_provider_owner_wallet

# Admin wallet/token: approves providers and writes admin-only marketplace actions.
QMA_ADMIN_WALLET=0xadmin_wallet
QMA_ADMIN_TOKEN=replace-with-admin-review-token

# Future gasless withdraw relayer. Address is public; private key must stay server-only.
QMA_WITHDRAW_RELAYER_ADDRESS=0xhot_relayer_wallet
# QMA_WITHDRAW_RELAYER_PRIVATE_KEY=0xnever_commit_real_or_funded_private_keys

# Network Mode Profile (Testnet vs Mainnet)
# Set to "testnet" or "mainnet" to automatically switch all chain IDs, RPCs, explorers,
# Gateway contracts, and CCTP TokenMessengers without altering individual addresses.
QMA_NETWORK_MODE=testnet

# Arc Network & Contract Config (Overrides - optional if using standard defaults)
# Testnet default: chain 5042002 | Mainnet default: chain 5042
# QMA_ARC_CHAIN_ID=5042002
# QMA_ARC_RPC_URL=https://rpc.testnet.arc.network
# QMA_ARC_EXPLORER=https://testnet.arcscan.app
# QMA_PAYMENT_NETWORK=eip155:5042002
# QMA_PAYMENT_NETWORK_NAME=Arc Testnet

# Smart Contract Addresses on Arc (Deploy or use canonical addresses)
QMA_ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
QMA_ARC_EURC_ADDRESS=0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a
QMA_ARC_GATEWAY_WALLET=0x0077777d7EBA4688BDeF3E311b846F25870A19B9
QMA_ARC_GATEWAY_MINTER=0x0022222ABE238Cc2C7Bb1f21003F0a260052475B
QMA_ARC_GATEWAY_DOMAIN=26
QMA_MAINNET_GATEWAY_WALLET=0x77777777Dcc4d5A8B6E418Fd04D8997ef11000eE
QMA_ARC_USYC_VAULT_ADDRESS=0x934e7309d7fca371db946b0643f2136cc0a0fcb2
QMA_SHIELD_CONTRACT_ADDRESS=0x367728bf66Cf962Ce15fD2b65193b7a1466f087c
QMA_ARC_HEDGE_RELAYER_CONTRACT=0x0077777d7EBA4688BDeF3E311b846F25870A19B9

# Circle StableFX Institutional RFQ Desk Configuration
QMA_STABLEFX_EURC_USD_RATE=1.0850
QMA_STABLEFX_SPREAD_BPS=5
QMA_STABLEFX_QUOTE_TTL_SECONDS=60

# Circle developer-controlled treasury executor (arc_gateway only).
CIRCLE_CONSOLE_API_KEY=replace-with-circle-console-api-key
CIRCLE_ENTITY_SECRET=replace-with-circle-entity-secret
TREASURY_WALLET_ID=replace-with-wallet-id-matching-platform-treasury
QMA_GATEWAY_MAX_FEE_RAW=2010000
# Required only when the treasury is an SCA; register this EOA as its Gateway delegate.
# QMA_GATEWAY_DELEGATE_WALLET_ID=replace-with-circle-eoa-wallet-id
# QMA_GATEWAY_DELEGATE_ADDRESS=0xregistered_gateway_delegate
# Internal secret used only for qma-api <-> arc_gateway server calls.
QMA_ARC_GATEWAY_INTERNAL_SECRET=replace-with-sidecar-internal-secret
# API background retry interval for finalized verdict payouts/refunds.
QMA_ARC_SETTLEMENT_RECONCILE_SECONDS=30

# Server secrets
QMA_ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
# Buyer-visible split-leg URL signing secret. Keep separate from QMA_ARC_GATEWAY_INTERNAL_SECRET.
QMA_SPLIT_LEG_URL_SECRET=replace-with-different-split-url-secret

# Persistent storage. Leave service role blank for local JSON fallback.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key-server-only
SUPABASE_SCHEMA=public

# Data paths. Keep sample paths for local demo; override for private/full datasets.
QMA_HISTORICAL_DB_PATH=data/sample_funding_historical_analysis.csv
QMA_BACKTEST_OUTCOME_PATH=data/sample_trading_analysis.csv

# Local sidecar URL. For production, set this to the deployed arc_gateway service URL.
QMA_ARC_GATEWAY_URL=http://127.0.0.1:3000

# GenLayer Intelligent Contract (Studio Next, chain 61997)
GENLAYER_NETWORK=studio-next
GENLAYER_RPC_ENDPOINT=https://studio-next.genlayer.com/api
GENLAYER_CONTRACT_ADDRESS=replace-with-deployed-contract-address
GENLAYER_PRIVATE_KEY=replace-with-relayer-funded-private-key
