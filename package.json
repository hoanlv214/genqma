{
  "name": "qma",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:frontend": "bun --filter frontend dev",
    "build:frontend": "bun --filter frontend build",
    "dev:gateway": "bun --filter qma-arc-gateway start",
    "dev:worker": "bun --filter qma-cli start:worker",
    "build:all": "bun --filter \"*\" build",
    "deploy:fe": "bun x vercel --prod",
    "deploy:vercel": "python scripts/vercel_sync.py --cli --all",
    "deploy:vercel:env": "python scripts/vercel_sync.py --cli --sync-env",
    "deploy:render": "python scripts/render_sync.py --distributed --sync-env --deploy",
    "deploy:render:status": "python scripts/render_sync.py --distributed --status",
    "deploy:render:inspect": "python scripts/render_sync.py --distributed --inspect all",
    "deploy:db": "bun x supabase db execute -f scripts/schema.sql",
    "deploy:genlayer": "node scripts/deploy_genqma_shield.mjs",
    "agent:build": "tsc -p agents/tsconfig.json",
    "agent:preview": "node agents/bin/agent_buyer.js --live --tier preview",
    "agent:full": "node agents/bin/agent_buyer.js --live --tier full",
    "agent:swarm": "node scripts/qma_agent_swarm.mjs",
    "sg:smoke": "powershell -ExecutionPolicy Bypass -File scripts/ast_grep_smoke.ps1",
    "sg:routes": "sg scan -r .ast-grep/rules/python-fastapi-app-route.yml backend main.py tests",
    "sg:invoice": "sg scan -r .ast-grep/rules/python-save-invoice-call.yml backend main.py tests",
    "sg:ledger": "sg scan -r .ast-grep/rules/python-save-payment-ledger-call.yml backend main.py tests",
    "sg:payment-gates": "sg scan -r .ast-grep/rules/python-payment-required-exception.yml backend main.py tests",
    "sg:state": "sg scan -r .ast-grep/rules/python-state-invoices-direct-write.yml backend main.py tests",
    "sg:http": "sg scan -r .ast-grep/rules/python-requests-post-call.yml backend/app/api backend/app/main.py"
  },
  "workspaces": [
    "frontend",
    "arc_gateway",
    "agents"
  ],
  "dependencies": {
    "@circle-fin/cli": "^1.1.1",
    "viem": "^2.48.11"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.44.1"
  }
}
